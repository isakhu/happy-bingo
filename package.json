{
  "name": "happy-bingo",
  "version": "0.1.0",
  "description": "Happy Bingo - offline Bingo caller and management system",
  "main": "out/main/index.js",
  "author": "Yishak Tule",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "electron-vite": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "build": {
    "appId": "com.happybingo.desktop",
    "productName": "Happy Bingo",
    "files": ["out/**/*", "package.json"],
    "win": { "target": "nsis", "artifactName": "Happy-Bingo-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
